# Copy to .env and fill in. Never commit .env — it is gitignored.

# Server
PORT=3000

# Postgres (Render → Database → "Internal Database URL")
DATABASE_URL=postgresql://user:password@host:5432/dbname

# WhatsApp Cloud API (Meta App Dashboard → WhatsApp → API Setup)
# Any string you choose; must match the token entered in Meta's webhook config
WHATSAPP_VERIFY_TOKEN=
# The Phone Number ID, not the phone number itself
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

# Groq (console.groq.com → API Keys)
GROQ_API_KEY=
